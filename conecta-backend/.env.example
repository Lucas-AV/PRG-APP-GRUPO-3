# Porta do servidor (padrão 3000)
PORT=3000
=
# URL base usada para gerar URLs absolutas dos arquivos enviados.
# Em dev local pode deixar comentado — o servidor monta http://localhost:PORT automaticamente.
=
# Segredo do JWT (trocar em produção)
JWT_SECRET=conecta_secret_dev
=
# MercadoPago — pegue o access token de teste em
# https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx